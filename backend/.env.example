# Copy this file to .env and fill in values. Never commit the real .env.

# Model 1 (Person A's binary stress classifier)
# If ./stress_model folder exists, backend loads it directly into memory locally!
# Otherwise, set MODEL_API_URL or USE_MOCK_MODEL=true.
MODEL_API_URL=http://localhost:8001/predict
USE_MOCK_MODEL=true
MODEL_LOCAL_PATH=./stress_model

# Local Whisper Transcription (runs locally via openai-whisper)
# Set USE_MOCK_TRANSCRIPTION=true for instant mock transcriptions during testing
USE_MOCK_TRANSCRIPTION=true

# Local Reason Extraction via Ollama (100% free, runs locally)
# Install from https://ollama.com and run: ollama pull llama3.2:1b
USE_OLLAMA_REASONING=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=5.0

# SQLite database file path
DB_PATH=./stress_app.db

# Optional sentiment & linguistic intensity fusion (app/sentiment_intensity.py)
ENABLE_SENTIMENT_FUSION=false


