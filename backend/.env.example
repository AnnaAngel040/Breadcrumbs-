# Copy this file to .env and fill in real values. Never commit the real .env.

# OpenAI key, used for Whisper transcription
OPENAI_API_KEY=sk-...

# Person A's model endpoint. Point this at their FastAPI/Flask server once it's up.
# Expected contract (agree on this with A explicitly):
#   POST {MODEL_API_URL}
#   body: {"transcript": "<text>"}
#   response: {"stress_score": 0.0-1.0, "category": "<string>", "confidence": 0.0-1.0}
MODEL_API_URL=http://localhost:8001/predict

# If USE_MOCK_MODEL=true, the pipeline skips MODEL_API_URL entirely and uses a
# local fake model (app/model_client.py) so you can build/test end-to-end before
# Person A's real endpoint exists.
USE_MOCK_MODEL=true

# Topic categorization is its own layer (app/categorize.py), separate from
# A's model, since Dreaddit doesn't cover the full taxonomy. true = try the
# LLM first (uses OPENAI_API_KEY above), falling back to keyword matching on
# any failure. false = always use keyword matching only (no API calls).
USE_LLM_CATEGORIZATION=true

# Optional real-therapist search (Google Places + LLM specialty tagging).
# Leave false unless you've set up billing on a Google Cloud project and
# tested this yourself — it silently falls back to the static therapist
# directory (app/therapists.json) whenever it's off, unconfigured, or fails.
USE_REAL_THERAPIST_SEARCH=false
GOOGLE_PLACES_API_KEY=

# SQLite file path
DB_PATH=./stress_app.db

# Optional sentiment and linguistic intensity fusion (app/sentiment_intensity.py).
ENABLE_SENTIMENT_FUSION=false

