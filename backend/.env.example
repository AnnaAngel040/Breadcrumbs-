# Copy this file to .env and fill in real values. Never commit the real .env.

# OpenAI key, used for Whisper transcription
OPENAI_API_KEY=sk-...

# Person A's model endpoint. Point this at their FastAPI/Flask server once it's up.
# Expected contract (agree on this with A explicitly):
#   POST {MODEL_API_URL}
#   body: {"transcript": "<text>"}
#   response: {"stress_score": 0.0-1.0, "category": "<string>", "confidence": 0.0-1.0}
MODEL_API_URL=http://localhost:8001/predict

# If USE_MOCK_MODEL=true, the pipeline skips MODEL_API_URL entirely and uses a
# local fake model (app/mock_model.py) so you can build/test end-to-end before
# Person A's real endpoint exists.
USE_MOCK_MODEL=true

# SQLite file path
DB_PATH=./stress_app.db
